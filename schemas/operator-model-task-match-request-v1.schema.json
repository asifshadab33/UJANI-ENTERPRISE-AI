{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ujani.ai/schemas/operator-model-task-match-request-v1.schema.json",
  "title": "UJANI Operator Model Task Match Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device_id",
    "model_ref",
    "requirements"
  ],
  "properties": {
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "model_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?=.*\\S)(?!/)(?!.*\\.\\.)(?!.*\\\\)(?!.*://)(?!.*[/]$)[^\\u0000-\\u001F]{1,160}$"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_capabilities"
      ],
      "properties": {
        "required_capabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "chat",
              "reasoning",
              "coding",
              "vision",
              "embeddings",
              "tool_use",
              "streaming",
              "audio_input",
              "audio_output"
            ]
          }
        },
        "minimum_context_length_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "minimum_memory_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
