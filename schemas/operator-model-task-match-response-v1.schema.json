{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ujani.ai/schemas/operator-model-task-match-response-v1.schema.json",
  "title": "UJANI Operator Model Task Match Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_ref",
        "status",
        "reasons",
        "evidence_confidence"
      ],
      "properties": {
        "model_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "enum": [
            "compatible",
            "incompatible",
            "unknown"
          ]
        },
        "reasons": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "enum": [
              "model_not_installed",
              "runtime_unavailable",
              "runtime_availability_unknown",
              "runtime_evidence_not_fresh",
              "model_evidence_not_fresh",
              "runtime_network_scope_unknown",
              "capability_not_declared",
              "capability_evidence_unknown",
              "context_length_unknown",
              "context_length_too_short",
              "hardware_memory_unknown",
              "memory_estimate_unknown",
              "memory_estimate_exceeds_available",
              "memory_estimate_within_available",
              "hardware_memory_below_requirement"
            ]
          }
        },
        "evidence_confidence": {
          "type": "string",
          "enum": [
            "verified",
            "reported",
            "estimated",
            "unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_confidence": {
                "enum": [
                  "estimated",
                  "unknown"
                ]
              }
            },
            "required": [
              "evidence_confidence"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "not": {
                  "const": "compatible"
                }
              }
            }
          }
        }
      ]
    }
  }
}
