{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ujani.example/schemas/fleet-inventory-v1.schema.json",
  "title": "UJANI Enterprise Fleet Inventory Snapshot",
  "description": "Read-only inventory contract. Authentication, tenant scope and source verification are enforced by the server, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_unix_ms",
    "source",
    "summary",
    "devices"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at_unix_ms": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "enrolled",
        "revoked",
        "fresh",
        "stale",
        "unknown"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "enrolled": {
          "type": "integer",
          "minimum": 0
        },
        "revoked": {
          "type": "integer",
          "minimum": 0
        },
        "fresh": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "devices": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/device"
      }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "display_name",
        "platform",
        "trust",
        "owner_opted_in",
        "admin_approved",
        "power_state",
        "last_seen_unix_ms",
        "telemetry_collected_unix_ms",
        "telemetry_source",
        "freshness"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "tenant_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "site_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "subnet_label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "platform_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "agent_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "policy_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "cpu_logical_cores": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "memory_total_mb": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "memory_available_mb": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "storage_free_mb": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "gpu_summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "npu_summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "trust": {
          "enum": [
            "unverified",
            "enrolled",
            "revoked"
          ]
        },
        "owner_opted_in": {
          "type": "boolean"
        },
        "admin_approved": {
          "type": "boolean"
        },
        "power_state": {
          "enum": [
            "running",
            "sleeping",
            "powered_off",
            "unknown"
          ]
        },
        "last_seen_unix_ms": {
          "type": "integer",
          "minimum": 1
        },
        "telemetry_collected_unix_ms": {
          "type": "integer",
          "minimum": 1
        },
        "telemetry_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "health_flags": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    }
  }
}
